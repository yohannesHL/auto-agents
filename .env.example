# auto-agents monorepo — environment variables
#
# Copy this file to .env and fill in the values you need.
# Lines beginning with # are comments.  Uncommented lines show sensible
# defaults; you only need to change them if your setup differs.
#
# TRACKING / TELEMETRY
#   All external tracking is disabled by default in docker-compose.yml:
#     openclaw  OTEL endpoints are blank  →  no metrics/traces exported
#               OPENCLAW_DISABLE_BONJOUR=1  →  no mDNS/Bonjour broadcasts
#     hermes    WANDB_API_KEY absent  →  no W&B experiment tracking
#               analytics endpoints are LOCAL only (sqlite dashboard)
#     pi        PI_TELEMETRY=0  →  no install-version ping to pi.dev
#   These values are hard-coded in docker-compose.yml and do NOT need to
#   be set here unless you explicitly want to re-enable them.

# =============================================================================
# SHARED — MODEL PROVIDER API KEYS
# Set at least one.  These are passed to all three agents.
# =============================================================================

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini / AI Studio
# GEMINI_API_KEY=
# GOOGLE_API_KEY=         # alias — only one is needed

# OpenRouter (access to 200+ models via one key)
# OPENROUTER_API_KEY=sk-or-...

# =============================================================================
# OPENCLAW
# Personal AI gateway — multi-channel (Telegram, Discord, Slack, WhatsApp…)
# Docs: https://docs.openclaw.ai
# =============================================================================

# Gateway authentication token.  Leave blank to auto-generate on first start.
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Optional password-based auth (use TOKEN or PASSWORD, not both).
# OPENCLAW_GATEWAY_PASSWORD=

# Timezone for the gateway process (IANA format, e.g. America/New_York).
OPENCLAW_TZ=UTC

# Docker image tag to use.  Defaults to building from ./agents/openclaw.
# OPENCLAW_IMAGE=auto-agents/openclaw:local

# Port mappings (host:container).
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# Network bind mode: "lan" (default), "localhost", or "all".
OPENCLAW_GATEWAY_BIND=lan

# Host-side paths for openclaw state.  Defaults to named Docker volumes.
# OPENCLAW_CONFIG_DIR=/path/on/host/.openclaw
# OPENCLAW_WORKSPACE_DIR=/path/on/host/.openclaw/workspace

# --- Channels (set only what you enable) ---
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# --- Claude web / browser session (optional) ---
# CLAUDE_AI_SESSION_KEY=
# CLAUDE_WEB_SESSION_KEY=
# CLAUDE_WEB_COOKIE=

# --- OpenTelemetry (OTEL) — leave blank to disable all export ---
# These are explicitly blanked in docker-compose.yml.  Uncomment and fill in
# an OTLP endpoint only if you run your own observability stack (e.g. Grafana
# Cloud, Honeycomb, self-hosted Tempo/Prometheus).
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=openclaw-gateway

# --- Additional provider keys (openclaw-specific aliases) ---
# OPENCLAW_LIVE_OPENAI_KEY=
# OPENCLAW_LIVE_ANTHROPIC_KEY=
# OPENCLAW_LIVE_GEMINI_KEY=
# ZAI_API_KEY=
# MINIMAX_API_KEY=
# BRAVE_API_KEY=
# PERPLEXITY_API_KEY=pplx-...
# FIRECRAWL_API_KEY=
# ELEVENLABS_API_KEY=
# DEEPGRAM_API_KEY=

# =============================================================================
# HERMES
# Self-improving AI agent — Nous Research
# Docs: https://hermes-agent.nousresearch.com/docs/
# =============================================================================

# Docker image tag.  Defaults to building from ./agents/hermes.
# HERMES_IMAGE=auto-agents/hermes:local

# UID/GID the container process runs as (maps to your host user so volume files
# are readable/writable).  Run: id -u && id -g to find your values.
HERMES_UID=10000
HERMES_GID=10000

# Host-side path for hermes state (~/.hermes equivalent inside Docker).
# HERMES_DATA_DIR=/path/on/host/.hermes

# Dashboard port (host-side).  Binds to 127.0.0.1 only for security.
HERMES_DASHBOARD_PORT=9119

# --- Channels ---
# TELEGRAM_BOT_TOKEN=          # shared with openclaw if using both
# TELEGRAM_ALLOWED_USERS=      # comma-separated Telegram user IDs
# TELEGRAM_HOME_CHANNEL=       # default chat ID for cron delivery
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# DISCORD_BOT_TOKEN=
# WHATSAPP_ENABLED=false
# WHATSAPP_ALLOWED_USERS=15551234567

# --- Additional provider keys (hermes-specific) ---
# GLM_API_KEY=                 # z.ai / ZhipuAI GLM
# KIMI_API_KEY=                # Kimi / Moonshot
# MINIMAX_API_KEY=             # MiniMax
# ARCEEAI_API_KEY=
# HF_TOKEN=                    # Hugging Face inference
# XIAOMI_API_KEY=              # Xiaomi MiMo

# --- Tool integrations ---
# EXA_API_KEY=                 # Exa AI web search
# FIRECRAWL_API_KEY=           # Firecrawl crawl/extract
# FAL_KEY=                     # fal.ai image generation
# HONCHO_API_KEY=              # cross-session user modeling
# BROWSERBASE_API_KEY=         # cloud browser automation
# BROWSERBASE_PROJECT_ID=
# GROQ_API_KEY=                # Groq Whisper STT (free tier)
# VOICE_TOOLS_OPENAI_KEY=      # OpenAI Whisper + TTS

# --- Microsoft Teams ---
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=
# TEAMS_TENANT_ID=
# TEAMS_ALLOWED_USERS=
# TEAMS_PORT=3978

# --- RL training (opt-in) ---
# Weights & Biases: WANDB_API_KEY is intentionally absent so no W&B tracking
# fires.  Uncomment only if you actively use Atropos RL training.
# WANDB_API_KEY=
# TINKER_API_KEY=
# RL_API_URL=http://localhost:8080

# --- Debug flags ---
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
IMAGE_TOOLS_DEBUG=false

# =============================================================================
# PI
# Minimal terminal coding harness — pi-mono coding-agent package
# Docs: https://github.com/badlogic/pi-mono/tree/main/packages/coding-agent
# =============================================================================

# Docker image tag.  Defaults to building from ./agents/pi.
# PI_IMAGE=auto-agents/pi:local

# Host-side path for pi sessions/settings.
# PI_DATA_DIR=/path/on/host/.pi

# Install-version telemetry is HARD-DISABLED (PI_TELEMETRY=0) in
# docker-compose.yml and does not need to be set here.
# Source: agents/pi/src/core/telemetry.ts — fetch to pi.dev/api/report-install

# =============================================================================
# GO SERVICE (stub)
# Replace ./services/go-service with your own Go agent implementation.
# =============================================================================

# GO_SERVICE_IMAGE=auto-agents/go-service:local
GO_SERVICE_PORT=8080

# =============================================================================
# RUST SERVICE (stub)
# Replace ./services/rust-service with your own Rust agent implementation.
# =============================================================================

# RUST_SERVICE_IMAGE=auto-agents/rust-service:local
RUST_SERVICE_PORT=8081
